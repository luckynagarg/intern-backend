# ============================================
# Required Resend Configuration
# ============================================
# Resend API Key
# Get it from: https://resend.com/api-keys

RESEND_API_KEY=re_9afArego_PR2SxUzsKcKqkdSWFPtvCZ4v

# Sender email address (must be a verified domain in Resend)
# Example: "InternArea <no-reply@yourdomain.com>"
EMAIL_FROM=InternArea <no-reply@yourdomain.com>

# Sender display name for outgoing emails (optional)
EMAIL_FROM_NAME=InternArea

# ============================================
# MongoDB
# ============================================
# MongoDB connection string (default: localhost)
MONGO_URI=mongodb://localhost:27017/internarea

# ============================================
# Firebase Admin
# ============================================
# Option 1: Full service account JSON (recommended)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Option 2: Individual Firebase Admin credentials
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================
# Razorpay (Subscription/Payments)
# ============================================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_CURRENCY=INR

# ============================================
# OTP Security
# ============================================
# Secret key for HMAC-SHA256 OTP hashing
OTP_HMAC_SECRET=your-otp-hmac-secret-min-32-chars-long-string

# ============================================
# Admin
# ============================================
ADMIN_USER=admin
ADMIN_PASS=admin123
ADMIN_EMAIL=your-email@gmail.com
ADMIN_NAME=InternArea Admin

# ============================================
# CORS / Frontend
# ============================================
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com

# ============================================
# App
# ============================================
PORT=5000
NODE_ENV=development