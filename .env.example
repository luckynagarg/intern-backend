# Backend environment variables example

# App
PORT=5000

# MongoDB
MONGODB_URI=

# CORS / other config (optional)

# Admin login (only for simple gate; prefer Firebase/JWT + role claims in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Firebase Admin uses service account credentials in backend/config/firebaseAdmin.js
# If that file reads FIREBASE_SERVICE_ACCOUNT_JSON or similar, add it here.
# e.g. FIREBASE_SERVICE_ACCOUNT_JSON={...}

